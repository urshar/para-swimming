# Vorlage für die .env auf dem Produktionsserver (netcup Webhosting, siehe docs/deployment.md).
# Auf dem Server nach .env kopieren und die Platzhalter <...> ersetzen. Die echte .env nie committen.

APP_NAME="Para Swimming"
APP_ENV=production
# Mit "php artisan key:generate" erzeugen (oder den Dev-Schlüssel übernehmen, siehe docs/deployment.md "APP_KEY").
APP_KEY=
APP_DEBUG=false
APP_URL=https://paraswim.at

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_AT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
# netcup: eigener Datenbankserver — Host steht in Plesk bei der Datenbank (meist eine interne IP, nicht localhost).
DB_HOST=<datenbankserver aus Plesk>
DB_PORT=3306
DB_DATABASE=<datenbankname aus Plesk>
DB_USERNAME=<datenbankbenutzer aus Plesk>
# Immer in einfachen Anführungszeichen: Sonst schneidet # den Rest als Kommentar ab und $ wird als Variable gelesen.
DB_PASSWORD='<passwort>'

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Zwei-Faktor-Pflicht für Benutzer mit Schreibrechten und Admins (Spec club-permissions §4.7)
AUTH_TWO_FACTOR_REQUIRED=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Abgearbeitet vom Scheduler-Cronjob (routes/console.php), kein dauerhafter Worker nötig.
QUEUE_CONNECTION=database

CACHE_STORE=database

# Postfach in Plesk anlegen (z. B. noreply@paraswim.at); Server und Port stehen in Plesk unter "E-Mail".
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=<mailserver aus Plesk>
MAIL_PORT=465
MAIL_USERNAME=noreply@paraswim.at
MAIL_PASSWORD=<passwort>
MAIL_FROM_ADDRESS="noreply@paraswim.at"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
